                        {{#each benchmark.component_reads as |cr|}}
                        .saturating_add(RocksDbWeight::get().reads(({{cr.slope}}_u64).saturating_mul({{cr.name}}.into())))
                        {{/each}}
                        {{#if (ne benchmark.base_writes "0")}}
