// ============================================================================
// Test Suite 2: Voting
// ============================================================================

#[test]
fn cast_vote_works() {
    new_test_ext().execute_with(|| {
        // Submit proposal
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1, // Economic
            0, // Simple majority
            false,
        ));

        // Fast forward to voting period
        run_to_block(28_801); // After launch period

        // Bob votes Aye with conviction 1
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0, // Proposal ID
            0, // Aye
            1, // Conviction
        ));

        // Check vote was recorded
        let vote = BelizeGovernance::votes(0, 2).unwrap();
        assert_eq!(vote.vote, VoteChoice::Aye);
        assert_eq!(vote.weight, 230); // Bob's weight: 80 + 150 = 230

        // Check proposal tally updated
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.vote_tally.ayes, 230);
        assert_eq!(proposal.status, ProposalStatus::Voting);

        // Check event
        assert_eq!(
            last_event(),
            RuntimeEvent::BelizeGovernance(Event::VoteCast {
                proposal_id: 0,
                voter: 2,
                vote_index: 0,
                weight: 230,
            })
        );
    });
}

#[test]
fn cast_vote_with_conviction_multiplier_works() {
    new_test_ext().execute_with(|| {
        // Submit proposal
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // Bob votes with conviction 5
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0,
            0, // Aye
            5, // High conviction
        ));

        let vote = BelizeGovernance::votes(0, 2).unwrap();
        // Weight should be multiplied: 230 * 5 = 1150
        assert_eq!(vote.weight, 1150);
    });
}

#[test]
fn cast_vote_before_voting_period_fails() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        // Try to vote during launch period
        assert_noop!(
            BelizeGovernance::cast_vote(
                RuntimeOrigin::signed(2),
                0,
                0,
                1,
            ),
            Error::<Test>::VotingPeriodNotStarted
        );
    });
}

#[test]
fn cast_vote_after_voting_period_fails() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        // Fast forward past voting period
        run_to_block(28_801 + 100_800 + 1); // After voting end

        assert_noop!(
            BelizeGovernance::cast_vote(
                RuntimeOrigin::signed(2),
                0,
                0,
                1,
            ),
            Error::<Test>::VotingPeriodEnded
        );
    });
}

#[test]
fn cast_vote_twice_fails() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // First vote succeeds
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0,
            0,
            1,
        ));

        // Second vote fails
        assert_noop!(
            BelizeGovernance::cast_vote(
                RuntimeOrigin::signed(2),
                0,
                1, // Try to change to Nay
                1,
            ),
            Error::<Test>::AlreadyVoted
        );
    });
}

