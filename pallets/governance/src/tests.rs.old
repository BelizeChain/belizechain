use crate::{mock::*, Error, Event, ProposalStatus, VoteChoice};
use frame_support::{assert_noop, assert_ok, traits::Currency};

// ============================================================================
// Test Suite 1: Proposal Submission
// ============================================================================

#[test]
fn submit_proposal_works() {
    new_test_ext().execute_with(|| {
        // Alice submits a proposal
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test Proposal".to_vec(),
            b"This is a test proposal description".to_vec(),
            1, // Economic type
            1, // Supermajority threshold
            false, // Not emergency
            None, // No district
        ));

        // Check proposal was created
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.proposer, 1);
        assert_eq!(proposal.status, ProposalStatus::Pending);
        assert!(!proposal.is_emergency);

        // Check deposit was reserved
        assert_eq!(
            Balances::reserved_balance(1),
            1_000_000_000 // 1000 DALLA
        );

        // Check event
        assert_eq!(
            last_event(),
            RuntimeEvent::BelizeGovernance(Event::ProposalSubmitted {
                proposal_id: 0,
                proposer: 1,
                proposal_type_index: 1,
                threshold_index: 1,
            })
        );
    });
}

#[test]
fn submit_proposal_insufficient_deposit_fails() {
    new_test_ext().execute_with(|| {
        // Create compliant account (6) with insufficient balance (only 100 DALLA)
        Balances::make_free_balance_be(&6, 100_000_000); // 100 DALLA
        
        // Try to submit proposal requiring 1000 DALLA deposit
        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(6),
                b"Test".to_vec(),
                b"Test".to_vec(),
                0, // Constitutional
                2, // Unanimous
                false,
            ),
            pallet_balances::Error::<Test>::InsufficientBalance
        );
    });
}

#[test]
fn submit_emergency_proposal_works() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Emergency Proposal".to_vec(),
            b"Critical security fix".to_vec(),
            4, // Emergency type
            1, // Supermajority
            true, // Emergency flag
        None,
        ));

        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert!(proposal.is_emergency);
        
        // Emergency proposals have shorter launch period (1 hour = 600 blocks)
        assert_eq!(proposal.voting_start, 1 + 3600); // Current block + 1 hour
    });
}

