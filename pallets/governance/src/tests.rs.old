fn cast_vote_nonexistent_proposal_fails() {
    new_test_ext().execute_with(|| {
        assert_noop!(
            BelizeGovernance::cast_vote(
                RuntimeOrigin::signed(2),
                999, // Non-existent proposal
                0,
                1,
            ),
            Error::<Test>::ProposalNotFound
        );
    });
}

#[test]
fn cast_vote_all_choices_work() {
    new_test_ext().execute_with(|| {
        // Create 3 proposals
        for _ in 0..3 {
            assert_ok!(BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                b"Test".to_vec(),
                b"Test".to_vec(),
                1,
                0,
                false,
            ));
        }

        run_to_block(28_801);

        // Vote Aye on proposal 0
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0,
            0, // Aye
            1,
        ));

        // Vote Nay on proposal 1
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            1,
            1, // Nay
            1,
        ));

        // Vote Abstain on proposal 2
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            2,
            2, // Abstain
            1,
        ));

        // Check tallies
        let proposal0 = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal0.vote_tally.ayes, 230);

        let proposal1 = BelizeGovernance::proposals(1).unwrap();
        assert_eq!(proposal1.vote_tally.nays, 230);

        let proposal2 = BelizeGovernance::proposals(2).unwrap();
        assert_eq!(proposal2.vote_tally.abstentions, 230);
    });
}

// ============================================================================
// Test Suite 3: Proposal Finalization
// ============================================================================

#[test]
fn finalize_proposal_approved_works() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0, // Simple majority (>50%)
            false,
        ));

        run_to_block(28_801);

        // Alice votes Aye (weight 300)
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(1),
            0,
            0,
            1,
        ));

        // Bob votes Nay (weight 230)
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0,
            1,
            1,
        ));

        // Fast forward past voting period
        run_to_block(28_801 + 100_801);

        // Finalize proposal
        assert_ok!(BelizeGovernance::finalize_proposal(
            RuntimeOrigin::signed(1),
            0,
        ));

        // Check proposal approved (300 ayes > 230 nays = 56.6% > 50%)
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Approved);

        // Check deposit returned
        assert_eq!(Balances::reserved_balance(1), 0);

        // Check event (should be in events list, may not be last due to Balances unreserve event)
        let all_events = System::events();
        let gov_events: Vec<_> = all_events
            .iter()
            .filter_map(|r| {
                if let RuntimeEvent::BelizeGovernance(e) = &r.event {
                    Some(e.clone())
                } else {
                    None
                }
            })
            .collect();
        
        assert!(matches!(
            gov_events.last(),
            Some(Event::ProposalApproved { proposal_id: 0, ayes: 300, nays: 230, abstentions: 0 })
        ));
    });
}

#[test]
fn finalize_proposal_rejected_works() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0, // Simple majority
            false,
        ));

        run_to_block(28_801);

        // Alice votes Nay (weight 300)
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(1),
            0,
            1, // Nay
            1,
        ));

        // Bob votes Aye (weight 230)
        assert_ok!(BelizeGovernance::cast_vote(
            RuntimeOrigin::signed(2),
            0,
            0,
            1,
        ));

        run_to_block(28_801 + 100_801);

        assert_ok!(BelizeGovernance::finalize_proposal(
            RuntimeOrigin::signed(2),
            0,
        ));

        // Check proposal rejected (230 ayes < 300 nays = 43.4% < 50%)
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Rejected);

        // Check event (filter governance events from all events)
        let all_events = System::events();
        let gov_events: Vec<_> = all_events
            .iter()
            .filter_map(|r| {
                if let RuntimeEvent::BelizeGovernance(e) = &r.event {
                    Some(e.clone())
                } else {
                    None
                }
            })
            .collect();
        
        assert!(matches!(
            gov_events.last(),
            Some(Event::ProposalRejected { proposal_id: 0, ayes: 230, nays: 300, abstentions: 0 })
        ));
    });
}

#[test]
fn finalize_proposal_supermajority_works() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            0, // Constitutional
            1, // Supermajority (66%)
            false,
        ));

        run_to_block(28_801);

        // All council votes Aye
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(2), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(3), 0, 0, 1));

        run_to_block(28_801 + 100_801);

        assert_ok!(BelizeGovernance::finalize_proposal(RuntimeOrigin::signed(1), 0));

        // Total: 300 + 230 + 160 = 690 ayes, 0 nays = 100% > 66%
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Approved);
    });
}

#[test]
fn finalize_proposal_supermajority_fails_insufficient_votes() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            0,
            1, // Supermajority (66%)
            false,
        ));

        run_to_block(28_801);

        // Alice votes Aye (300), Bob votes Nay (230)
        // 300 / (300 + 230) = 56.6% < 66%
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(2), 0, 1, 1));

        run_to_block(28_801 + 100_801);

        assert_ok!(BelizeGovernance::finalize_proposal(RuntimeOrigin::signed(1), 0));

        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Rejected);
    });
}

#[test]
fn finalize_proposal_before_voting_ends_fails() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1));

        // Try to finalize during voting period
        assert_noop!(
            BelizeGovernance::finalize_proposal(RuntimeOrigin::signed(1), 0),
            Error::<Test>::VotingPeriodEnded // Actually means "not ended yet"
        );
    });
}

// ============================================================================
// Test Suite 4: Community Rank & PoUW Updates
// ============================================================================

#[test]
fn update_community_rank_works() {
    new_test_ext().execute_with(|| {
        let old_rank = BelizeGovernance::community_ranks(2);
        assert_eq!(old_rank, 80);

        assert_ok!(BelizeGovernance::update_community_rank(
            RuntimeOrigin::root(),
            2,
            150,
        ));

        let new_rank = BelizeGovernance::community_ranks(2);
        assert_eq!(new_rank, 150);

        // Check council member updated
        let member = BelizeGovernance::council_members(2).unwrap();
        assert_eq!(member.community_rank, 150);
        assert_eq!(member.voting_weight, 150 + 150); // new_rank + pouw

        // Check event
        assert_eq!(
            last_event(),
            RuntimeEvent::BelizeGovernance(Event::CommunityRankUpdated {
                account: 2,
                old_rank: 80,
                new_rank: 150,
            })
        );
    });
}

#[test]
fn update_pouw_contribution_works() {
    new_test_ext().execute_with(|| {
        let old_contrib = BelizeGovernance::pouw_contributions(2);
        assert_eq!(old_contrib, 150);

        assert_ok!(BelizeGovernance::update_pouw_contribution(
            RuntimeOrigin::root(),
            2,
            250,
        ));

        let new_contrib = BelizeGovernance::pouw_contributions(2);
        assert_eq!(new_contrib, 250);

        // Check council member updated
        let member = BelizeGovernance::council_members(2).unwrap();
        assert_eq!(member.pouw_contribution, 250);
        assert_eq!(member.voting_weight, 80 + 250); // rank + new_pouw

        // Check event
        assert_eq!(
            last_event(),
            RuntimeEvent::BelizeGovernance(Event::PoUWContributionUpdated {
                account: 2,
                old_contribution: 150,
                new_contribution: 250,
            })
        );
    });
}

#[test]
fn update_community_rank_non_council_member_works() {
    new_test_ext().execute_with(|| {
        // Update rank for non-council member (account 4)
        assert_ok!(BelizeGovernance::update_community_rank(
            RuntimeOrigin::root(),
            4,
            50,
        ));

        let rank = BelizeGovernance::community_ranks(4);
        assert_eq!(rank, 50);

        // Should not have council member entry
        assert!(BelizeGovernance::council_members(4).is_none());
    });
}

