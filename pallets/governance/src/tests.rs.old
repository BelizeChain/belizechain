#[test]
fn genesis_config_builds_correctly() {
    new_test_ext().execute_with(|| {
        // Check council members initialized
        let alice = BelizeGovernance::council_members(1).unwrap();
        assert_eq!(alice.community_rank, 100);
        assert_eq!(alice.pouw_contribution, 200);
        assert_eq!(alice.voting_weight, 300);

        let bob = BelizeGovernance::council_members(2).unwrap();
        assert_eq!(bob.community_rank, 80);
        assert_eq!(bob.pouw_contribution, 150);
        assert_eq!(bob.voting_weight, 230);

        // Check community ranks
        assert_eq!(BelizeGovernance::community_ranks(1), 100);
        assert_eq!(BelizeGovernance::community_ranks(2), 80);

        // Check PoUW contributions
        assert_eq!(BelizeGovernance::pouw_contributions(1), 200);
        assert_eq!(BelizeGovernance::pouw_contributions(2), 150);

        // Check term initialized
        assert_eq!(BelizeGovernance::council_term(), 1);
    });
}

// ============================================================================
// Test Suite 8: Edge Cases & Error Conditions
// ============================================================================

#[test]
fn proposal_with_zero_votes_rejected() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        // Skip to after voting period without any votes
        run_to_block(28_801 + 100_801);

        assert_ok!(BelizeGovernance::finalize_proposal(RuntimeOrigin::signed(1), 0));

        // Proposal should be rejected (0/0 = 0% < 50%)
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Rejected);
    });
}

#[test]
fn voting_weight_calculation_works() {
    new_test_ext().execute_with(|| {
        // Account 4 (not council) has no weight
        assert_eq!(BelizeGovernance::community_ranks(4), 0);
        assert_eq!(BelizeGovernance::pouw_contributions(4), 0);

        // Give them some weight
        assert_ok!(BelizeGovernance::update_community_rank(RuntimeOrigin::root(), 4, 50));
        assert_ok!(BelizeGovernance::update_pouw_contribution(RuntimeOrigin::root(), 4, 30));

        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // Account 4 can now vote with combined weight
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(4), 0, 0, 1));

        let vote = BelizeGovernance::votes(0, 4).unwrap();
        assert_eq!(vote.weight, 80); // 50 + 30
    });
}

#[test]
fn multiple_proposals_independent() {
    new_test_ext().execute_with(|| {
        // Create multiple proposals
        for i in 0..5 {
            assert_ok!(BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                format!("Proposal {}", i).as_bytes().to_vec(),
                b"Test".to_vec(),
                1,
                0,
                false,
            ));
        }

        // Check next proposal ID
        assert_eq!(BelizeGovernance::next_proposal_id(), 5);

        // Each proposal is independent
        for i in 0..5 {
            let proposal = BelizeGovernance::proposals(i).unwrap();
            assert_eq!(proposal.id, i);
            assert_eq!(proposal.status, ProposalStatus::Pending);
        }
    });
}

#[test]
fn abstain_votes_dont_affect_outcome() {
    new_test_ext().execute_with(|| {
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // Alice: Aye, Bob: Nay, Charlie: Abstain
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1)); // Aye: 300
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(2), 0, 1, 1)); // Nay: 230
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(3), 0, 2, 1)); // Abstain: 160

        run_to_block(28_801 + 100_801);
        assert_ok!(BelizeGovernance::finalize_proposal(RuntimeOrigin::signed(1), 0));

        // Outcome: 300 / (300 + 230) = 56.6% > 50% -> Approved
        // Abstentions don't count in decisive votes
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.status, ProposalStatus::Approved);
        assert_eq!(proposal.vote_tally.abstentions, 160);
    });
}

// ============================================================================
// Test Suite 9: Compliance Integration
// ============================================================================

#[test]
fn restricted_account_cannot_submit_proposal() {
    new_test_ext().execute_with(|| {
        // Account 999 is restricted in MockCompliance
        Balances::make_free_balance_be(&999, 100_000_000_000);

        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(999),
                b"Restricted Proposal".to_vec(),
                b"Should fail".to_vec(),
                1,
                0,
                false,
            ),
            Error::<Test>::InsufficientCompliance
        );
    });
}

#[test]
fn restricted_account_cannot_cast_vote() {
    new_test_ext().execute_with(|| {
        // Alice submits proposal successfully
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // Account 999 is restricted and cannot vote
        Balances::make_free_balance_be(&999, 100_000_000_000);
        
        assert_noop!(
            BelizeGovernance::cast_vote(
                RuntimeOrigin::signed(999),
                0,
                0,
                1,
            ),
            Error::<Test>::InsufficientCompliance
        );
    });
}

#[test]
fn compliant_accounts_can_participate() {
    new_test_ext().execute_with(|| {
        // All standard accounts (1-5) are compliant
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        run_to_block(28_801);

        // All compliant accounts can vote
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(2), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(3), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(4), 0, 0, 1));
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(5), 0, 0, 1));

        // All votes recorded
        assert!(BelizeGovernance::votes(0, 1).is_some());
        assert!(BelizeGovernance::votes(0, 2).is_some());
        assert!(BelizeGovernance::votes(0, 3).is_some());
        assert!(BelizeGovernance::votes(0, 4).is_some());
        assert!(BelizeGovernance::votes(0, 5).is_some());
    });
}

#[test]
fn compliance_check_prevents_unauthorized_governance_participation() {
    new_test_ext().execute_with(|| {
        // Setup: Create proposal with compliant account
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Test".to_vec(),
            b"Test".to_vec(),
            1,
            0,
            false,
        ));

        // Verify restricted account (999) cannot interact at all
        Balances::make_free_balance_be(&999, 200_000_000_000);

        // Cannot submit new proposal
        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(999),
                b"Another".to_vec(),
                b"Test".to_vec(),
                1,
                0,
                false,
            ),
            Error::<Test>::InsufficientCompliance
        );

        run_to_block(28_801);

        // Cannot vote on existing proposal
        assert_noop!(
            BelizeGovernance::cast_vote(RuntimeOrigin::signed(999), 0, 0, 1),
            Error::<Test>::InsufficientCompliance
        );

        // Compliant accounts still work normally
        assert_ok!(BelizeGovernance::cast_vote(RuntimeOrigin::signed(1), 0, 0, 1));
    });
}

// ============================================================================
// Test Suite: District Proposals
// ============================================================================

#[test]
fn submit_district_proposal_works() {
    new_test_ext().execute_with(|| {
        // Alice submits a district-specific proposal for Belize District
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"Coastal Road Repair".to_vec(),
            b"Repair coastal road from Belize City to Ladyville".to_vec(),
            7, // DistrictLocal type
            0, // SimpleMajority threshold
            false, // Not emergency
            Some(0), // Belize District (index 0)
        ));

        // Check proposal was created with district field
        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert_eq!(proposal.proposer, 1);
        assert_eq!(proposal.status, ProposalStatus::Pending);
        assert!(proposal.district.is_some());

        // Check event emitted with correct type index
        assert_eq!(
            last_event(),
            RuntimeEvent::BelizeGovernance(Event::ProposalSubmitted {
                proposal_id: 0,
                proposer: 1,
                proposal_type_index: 7, // DistrictLocal
                threshold_index: 0,
            })
        );
    });
}

#[test]
fn submit_district_proposal_for_each_district() {
    new_test_ext().execute_with(|| {
        // Test all 6 districts: Belize, Cayo, Corozal, OrangeWalk, StannCreek, Toledo
        let districts = [
            (0, b"Belize District Project".to_vec()),
            (1, b"Cayo District Project".to_vec()),
            (2, b"Corozal District Project".to_vec()),
            (3, b"Orange Walk District Project".to_vec()),
            (4, b"Stann Creek District Project".to_vec()),
            (5, b"Toledo District Project".to_vec()),
        ];

        for (district_idx, title) in districts.iter() {
            assert_ok!(BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                title.clone(),
                b"District-specific infrastructure project".to_vec(),
                7, // DistrictLocal
                0, // SimpleMajority
                false,
                Some(*district_idx),
            ));
        }

        // Verify all 6 proposals were created
        for i in 0..6 {
            let proposal = BelizeGovernance::proposals(i).unwrap();
            assert!(proposal.district.is_some());
        }
    });
}

#[test]
fn district_local_proposal_requires_district() {
    new_test_ext().execute_with(|| {
        // Attempting to submit DistrictLocal proposal without district should fail
        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                b"Missing District".to_vec(),
                b"This should fail".to_vec(),
                7, // DistrictLocal type
                0,
                false,
                None, // No district specified
            ),
            Error::<Test>::DistrictRequired
        );
    });
}

#[test]
fn invalid_district_index_fails() {
    new_test_ext().execute_with(|| {
        // District index 6 or higher is invalid (only 0-5 valid)
        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                b"Invalid District".to_vec(),
                b"District index too high".to_vec(),
                7, // DistrictLocal
                0,
                false,
                Some(6), // Invalid: only 0-5 are valid
            ),
            Error::<Test>::InvalidDistrict
        );

        assert_noop!(
            BelizeGovernance::submit_proposal(
                RuntimeOrigin::signed(1),
                b"Invalid District".to_vec(),
                b"District index too high".to_vec(),
                7,
                0,
                false,
                Some(255), // Way too high
            ),
            Error::<Test>::InvalidDistrict
        );
    });
}

#[test]
fn national_proposal_can_have_optional_district_tag() {
    new_test_ext().execute_with(|| {
        // Non-DistrictLocal proposals can optionally specify a district for tagging
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"National Tourism Initiative".to_vec(),
            b"Promote Cayo tourism nationally".to_vec(),
            1, // Economic (not DistrictLocal)
            1, // Supermajority
            false,
            Some(1), // Optional Cayo district tag
        ));

        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert!(proposal.district.is_some()); // District tag present
    });
}

#[test]
fn national_proposal_without_district_works() {
    new_test_ext().execute_with(|| {
        // National proposals can omit district entirely
        assert_ok!(BelizeGovernance::submit_proposal(
            RuntimeOrigin::signed(1),
            b"National Policy".to_vec(),
            b"Applies to all of Belize".to_vec(),
            0, // Constitutional
            2, // Unanimous
            false,
            None, // No district
        ));

        let proposal = BelizeGovernance::proposals(0).unwrap();
        assert!(proposal.district.is_none()); // No district
    });
}
