# BelizeChain Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# =============================================================================
# Blockchain Node Configuration
# =============================================================================
# RPC/WebSocket endpoints
BLOCKCHAIN_RPC_HTTP=http://localhost:9933
BLOCKCHAIN_RPC_WS=ws://localhost:9944

# =============================================================================
# Network Configuration
# =============================================================================
# P2P Network
P2P_PORT=30333
RPC_PORT=9933
WS_PORT=9944

# =============================================================================
# Node Configuration
# =============================================================================
NODE_NAME=BelizeChain-Node-1
CHAIN=dev
BASE_PATH=./data
VALIDATOR=false
TELEMETRY_URL=wss://telemetry.polkadot.io/submit/

# Pruning and Database
PRUNING=archive
DATABASE=rocksdb

# =============================================================================
# Development Settings
# =============================================================================
# Environment (dev, staging, production)
ENVIRONMENT=dev

# Logging
LOG_LEVEL=info
RUST_LOG=info,runtime=debug
RUST_BACKTRACE=1

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production:
# [ ] Set ENVIRONMENT=production
# [ ] Set VALIDATOR=true (for validator nodes)
# [ ] Change NODE_NAME to unique identifier
# [ ] Configure proper BASE_PATH for persistent storage
# [ ] Set PRUNING=1000 (or archive for full nodes)
# [ ] Generate and configure session keys
# [ ] Configure SSL/TLS for RPC endpoints
# [ ] Set up proper backup strategy for chain data
# [ ] Enable firewall rules (allow P2P_PORT, restrict RPC/WS)
# [ ] Configure telemetry and monitoring
