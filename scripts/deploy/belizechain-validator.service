[Unit]
Description=BelizeChain Public Testnet Validator on Ceiba
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wicked
Group=wicked
ExecStartPre=/usr/bin/test -f /etc/belizechain/testnet-chain-spec-raw.json
ExecStartPre=/bin/sh -c '! grep -Eq '"'"'"id"[[:space:]]*:[[:space:]]*"belizechain_local"'"'"' /etc/belizechain/testnet-chain-spec-raw.json'
ExecStartPre=/bin/sh -c '! grep -Eq '"'"'"chainType"[[:space:]]*:[[:space:]]*"Local"'"'"' /etc/belizechain/testnet-chain-spec-raw.json'
ExecStartPre=/bin/sh -c '! grep -Eq '"'"'/ip4/(127\\.0\\.0\\.1|0\\.0\\.0\\.0)/|/dns4/localhost/'"'"' /etc/belizechain/testnet-chain-spec-raw.json'
ExecStart=/usr/local/bin/belizechain-node \
  --chain /etc/belizechain/testnet-chain-spec-raw.json \
  --base-path /data/chain \
  --port 30333 \
  --rpc-port 9944 \
  --prometheus-port 9615 \
  --prometheus-external \
  --rpc-cors all \
  --rpc-external \
  --rpc-methods Safe \
  --validator \
  --name Ceiba-Validator \
  --node-key-file /data/chain/node-key \
  --telemetry-url ""
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/chain
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
